{
  "name": "d1-api",
  "version": "1.0.0",
  "private": true,
  "description": "Cloudflare Worker — Secure D1 database API for पंडित हरिनाथ शास्त्री chatbot",
  "main": "src/index.ts",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "build": "wrangler deploy --dry-run",
    "db:migrate:local": "wrangler d1 migrations apply pandit-harinath-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply pandit-harinath-db --remote",
    "db:list:local": "wrangler d1 execute pandit-harinath-db --local --command=\"SELECT name FROM sqlite_master WHERE type='table'\"",
    "type-check": "tsc --noEmit"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20241127.0",
    "typescript": "^5.6.3",
    "wrangler": "^4.147.0"
  },
  "dependencies": {
    "vitest": "5.0.3"
  }
}
