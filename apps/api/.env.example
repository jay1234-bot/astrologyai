# ============================================================
# Environment Variables for पंडित हरिनाथ शास्त्री AI Backend
# Copy this file to .env and fill in the values
# NEVER commit .env to version control
# ============================================================

# ── Server ──
PORT=3000
NODE_ENV=development

# ── Google Gemini AI ──
# Get from: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# ── Meta WhatsApp Cloud API ──
# Get from: https://developers.facebook.com/apps/
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=

# ── WhatsApp Webhook Security ──
# WHATSAPP_VERIFY_TOKEN: Create any random string (e.g., use openssl rand -hex 32)
#   This is used for Meta webhook verification
WHATSAPP_VERIFY_TOKEN=

# META_APP_SECRET: Found in your Meta App Dashboard > App Settings > Basic
#   Used for HMAC-SHA256 webhook signature validation
META_APP_SECRET=

# ── Cloudflare D1 API Worker ──
# D1_API_URL: Your Cloudflare Worker URL (after deploying with wrangler deploy)
#   Example: https://pandit-harinath-d1-api.your-subdomain.workers.dev
D1_API_URL=
# D1_API_SECRET: Create any random string (e.g., openssl rand -hex 32)
#   Must match the secret set in the Cloudflare Worker (wrangler secret put D1_API_SECRET)
D1_API_SECRET=

# ── Admin API ──
# Create any random string for admin endpoint authentication
ADMIN_API_KEY=

# ── Application Behaviour ──
DEFAULT_LANGUAGE=en
AI_ENABLED=true

# ── Conversation Context ──
# Number of recent messages to include in AI context (max 50)
AI_CONTEXT_MESSAGE_LIMIT=15

# ── Rate Limiting ──
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=30
